# Copy to .env.local for local dev. Set the same variables in Vercel → Project → Settings → Environment Variables.
# Firebase web config as one JSON string (Firebase console → Project settings → Your apps → Web app → Config).
# Leave unset to run in DEMO mode with in-memory sample data and no sign-in.
VITE_FB_CONFIG=
# Email that is always admin, regardless of invites. Must also match ADMIN_EMAIL in firestore.rules.
VITE_ADMIN_EMAIL=mdulin@gmail.com
