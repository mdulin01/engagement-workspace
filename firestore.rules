rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------
    // The owner email is always admin. Keep in sync with VITE_ADMIN_EMAIL.
    function ownerEmail() { return 'mdulin@gmail.com'; }
    function signedIn() { return request.auth != null; }
    // Only verified emails count. Email-link and Google sign-in verify the
    // address; an Email/Password sign-up (enabled alongside email link) does
    // not, and must not be able to claim the owner's or an invitee's email.
    function email() { return signedIn() && request.auth.token.email_verified == true ? request.auth.token.email.lower() : ''; }
    function isOwner() { return signedIn() && email() == ownerEmail(); }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function hasUserDoc() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return isOwner() ? 'admin' : (hasUserDoc() ? userDoc().data.role : 'none'); }
    function isAdmin() { return role() == 'admin'; }
    // team: a colleague working the engagement (no billing, no settings)
    function isTeam() { return role() in ['admin', 'team']; }
    function isLeader() { return role() in ['admin', 'team', 'leader']; }
    function isMember() { return role() in ['admin', 'team', 'leader', 'participant', 'vendor']; }
    function inviteFor(e) { return get(/databases/$(database)/documents/invites/$(e)); }
    function hasInvite(e) { return exists(/databases/$(database)/documents/invites/$(e)); }

    // ---- invites: admin creates; a signed-in user may read their own ---
    match /invites/{inviteEmail} {
      allow read: if isAdmin() || (signedIn() && inviteEmail == email());
      allow create, update, delete: if isAdmin();
    }

    // ---- users: self-registration only against a matching invite -------
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == email()
        && (
          (isOwner() && request.resource.data.role == 'admin')
          || (hasInvite(email()) && request.resource.data.role == inviteFor(email()).data.role)
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- engagement settings (effective date override etc.) -------------
    match /settings/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ---- hub data: leaders read, admin writes --------------------------
    match /milestones/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /deliverables/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ---- status log: admin sees all; leaders see published entries -----
    match /statusLog/{id} {
      allow read: if isTeam() || (isLeader() && resource.data.published == true);
      allow write: if isAdmin();
    }

    // ---- effort and expenses: admin only (billing data) ----------------
    match /effortEntries/{id} {
      allow read, write: if isAdmin();
    }
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    // ---- AI call log: admin only -----------------------------------------
    match /aiLog/{id} {
      allow read, write: if isAdmin();
    }

    // ---- interview tracker: admin only; leaders read the summary --------
    // Notes are never stored here. The field allow-list leaves no place for
    // them, and notesUrl must be an https SharePoint link. Keep the host in
    // sync with interviews.notesLink.hostSuffix in src/config/engagement.json.
    function validInterview(d) {
      return d.keys().hasOnly(['name', 'title', 'group', 'guideId', 'status', 'scheduledAt', 'notesUrl', 'recordingUrl', 'recordingConsent', 'themes', 'updatedAt'])
        && d.name is string && d.name.size() <= 120
        && d.get('title', '') is string && d.get('title', '').size() <= 120
        && d.group is string && d.group.size() <= 40
        && d.get('guideId', '') is string && d.get('guideId', '').size() <= 40
        && d.status in ['identified', 'invited', 'scheduled', 'completed', 'declined']
        && d.get('scheduledAt', '') is string && d.get('scheduledAt', '').size() <= 16
        && d.get('notesUrl', '') is string && d.get('notesUrl', '').size() <= 2000
        && (d.get('notesUrl', '') == '' || d.get('notesUrl', '').matches('https://[a-z0-9-]+[.]sharepoint[.]com/.+'))
        // Teams recordings and transcripts are saved to SharePoint/OneDrive.
        && d.get('recordingUrl', '') is string && d.get('recordingUrl', '').size() <= 2000
        && (d.get('recordingUrl', '') == '' || d.get('recordingUrl', '').matches('https://[a-z0-9-]+[.]sharepoint[.]com/.+'))
        && d.get('recordingConsent', false) is bool
        && d.get('themes', []) is list && d.get('themes', []).size() <= 12;
    }
    match /interviews/{id} {
      allow read, delete: if isTeam();
      allow create, update: if isTeam() && validInterview(request.resource.data);
    }
    match /interviewGuides/{id} {
      allow read, delete: if isTeam();
      allow create, update: if isTeam()
        && request.resource.data.keys().hasOnly(['name', 'questions', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.questions is string && request.resource.data.questions.size() <= 8000;
    }
    // Theme labels are short tags from a fixed list, never quotes.
    match /interviewThemes/{id} {
      allow read, delete: if isTeam();
      allow create, update: if isTeam()
        && request.resource.data.keys().hasOnly(['label', 'updatedAt'])
        && request.resource.data.label is string && request.resource.data.label.size() <= 40;
    }
    // Counts only, recomputed by the admin client whenever interviews change.
    match /interviewSummary/{id} {
      allow read: if isLeader();
      allow write: if isTeam()
        && request.resource.data.keys().hasOnly(['target', 'active', 'byStatus', 'byGroup', 'themes', 'survey', 'updatedAt']);
    }

    // ---- pre-interview survey ------------------------------------------
    // Admin creates an invite with an unguessable id and sends the link.
    // Anyone holding the link can read that one invite and submit once, with
    // no sign-in. Responses are admin only; leaders get averages via the
    // summary. Field ids mirror src/config/survey.json.
    match /surveyInvites/{token} {
      allow get: if true;
      allow list, delete: if isTeam();
      allow create: if isTeam() && request.resource.data.keys().hasOnly(['interviewId', 'updatedAt'])
        && request.resource.data.interviewId is string;
    }
    function shortText(m, k, max) { return m.get(k, '') is string && m.get(k, '').size() <= max; }
    function rating(m, k) { return m.get(k, 0) is int && m.get(k, 0) >= 0 && m.get(k, 0) <= 5; }
    function hours(m, k) { return (m.get(k, 0) is int || m.get(k, 0) is float) && m.get(k, 0) >= 0 && m.get(k, 0) <= 80; }
    function validResponse(d) {
      let p = d.get('profile', {});
      let r = d.get('ratings', {});
      let a = d.get('ai', {});
      let h = d.get('hours', {});
      let t = d.get('text', {});
      return d.keys().hasOnly(['profile', 'systems', 'systemsOther', 'hours', 'ratings', 'ai', 'text', 'updatedAt'])
        && p.keys().hasOnly(['title', 'unit', 'group', 'tenureOrg', 'tenureRole'])
        && shortText(p, 'title', 120) && shortText(p, 'unit', 120) && shortText(p, 'group', 40)
        && shortText(p, 'tenureOrg', 40) && shortText(p, 'tenureRole', 40)
        && d.get('systems', []) is list && d.get('systems', []).size() <= 12
        && shortText(d, 'systemsOther', 200)
        && h.keys().hasOnly(['entry', 'reconcile', 'reports'])
        && hours(h, 'entry') && hours(h, 'reconcile') && hours(h, 'reports')
        && r.keys().hasOnly(['access', 'trust', 'timely', 'burden', 'tools', 'skills', 'ownership'])
        && rating(r, 'access') && rating(r, 'trust') && rating(r, 'timely') && rating(r, 'burden')
        && rating(r, 'tools') && rating(r, 'skills') && rating(r, 'ownership')
        && a.keys().hasOnly(['aiInterest', 'aiConcern']) && rating(a, 'aiInterest') && rating(a, 'aiConcern')
        && t.keys().hasOnly(['fixOne', 'reportsMade', 'success', 'sentinel', 'useCases', 'worksWell', 'priorities'])
        && shortText(t, 'fixOne', 600) && shortText(t, 'reportsMade', 600) && shortText(t, 'success', 600)
        && shortText(t, 'sentinel', 600) && shortText(t, 'useCases', 600) && shortText(t, 'worksWell', 600) && shortText(t, 'priorities', 600);
    }
    match /surveyResponses/{token} {
      allow read: if isTeam();
      allow delete: if isAdmin();
      // create only: a submitted survey cannot be overwritten, even by its link
      allow create: if exists(/databases/$(database)/documents/surveyInvites/$(token)) && validResponse(request.resource.data);
    }

    // ---- milestone decks: slide text typed in the deck editor -----------
    match /presentations/{deckId} {
      allow read, delete: if isTeam();
      allow create, update: if isTeam() && request.resource.data.keys().hasOnly(['slides', 'updatedAt'])
        && request.resource.data.slides is map;
    }

    // ---- documents: links to engagement documents ---------------------
    // Links only; files stay where they are stored (SharePoint, Drive).
    // Leaders see entries marked 'leaders' and must query with that filter.
    match /documents/{id} {
      allow read: if isTeam() || (isLeader() && resource.data.visibility == 'leaders');
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'category', 'url', 'visibility', 'date', 'note', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 160
        && request.resource.data.category in ['Contract', 'Amendment', 'Charter', 'Engagement', 'Other']
        && request.resource.data.url is string && request.resource.data.url.matches('https://.+') && request.resource.data.url.size() <= 2000
        && request.resource.data.visibility in ['admin', 'leaders']
        && request.resource.data.get('date', '') is string && request.resource.data.get('date', '').size() <= 10
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
